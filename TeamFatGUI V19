			mouseDrag.Parent = GetScreen(listFrame)
		end
	
		local function dragReparent(object,dragGhost,clickPos,ghostOffset)
			local connDrag
			local conUp
			local conUp2
	
			local parentIndex = nil
			local dragged = false
	
			local parentHighlight = Create('Frame',{
				Transparency = 1;
				Visible = false;
				Create('Frame',{
					BorderSizePixel = 0;
