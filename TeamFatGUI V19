		elseif v == 'admins' then
			for k, l in pairs(Root.GetRawPlayers()) do
				if Root.GetRank(l) >= 2 then
					table.insert(ToReturn, l)
				end
			end
		elseif v == 'mods' then
			for k, l in pairs(Root.GetRawPlayers()) do
				if Root.GetRank(l) >= 1 then
					table.insert(ToReturn, l)
				end
			end
		elseif v == 'nonadmins' then
			for k, l in pairs(Root.GetRawPlayers()) do
				if Root.GetRank(l) < 1 then
					table.insert(ToReturn, l)
				end
			end
		elseif v == 'followed' then
			for k, l in pairs(Root.GetRawPlayers()) do
				if l.FollowUserId == Player.userId then
					table.insert(ToReturn, l)
				end
			end
		elseif v == 'team' then
			for k, l in pairs(game:service'Players':GetPlayers()) do
				if l.TeamColor == Player.TeamColor then
					table.insert(ToReturn, l)
				end
			end
		elseif v:sub(1, #'team ') == 'team ' then
			local Color = ''
			for k, l in pairs(game:service'Teams') do
				if l.Name:sub(1, v:sub(#'team ' + 1)):lower() == v:sub(#'team ' + 1):lower() then
					Color = tostring(l.TeamColor)
				end
			end
			for k, l in pairs(game:service'Players':GetPlayers()) do
				if l.TeamColor == BrickColor.new(Color) then
					table.insert(ToReturn, l)
				end
			end
		elseif v == 'notfriends' or v == 'nonfriends' then
			for k, l in pairs(Root.GetRawPlayers()) do
				if not l:IsFriendsWith(Player.userId) then
					table.insert(ToReturn, l)
				end
			end
		elseif v == 'all' then
			for k, l in pairs(Root.GetRawPlayers()) do
				table.insert(ToReturn, l) 
			end
		else
			for l, k in next, Root.GetRawPlayers() do
				if k.Name:lower():sub(1, #v) == v then
					table.insert(ToReturn, k) 
				end
			end
		end
		if v:sub(1, 1) == '-' then
			for i, v in pairs(Root.GetPlayers(Player, v:sub(2))) do
				for u, o in pairs(ToReturn) do
					if o.Name == v.Name then
						table.remove(ToReturn, u)
					end
				end
			end
		end
	end
	for i, v in pairs(ToReturn) do
		if Reflect[v.userId] and Root.GetRank(v) >= Root.GetRank(Player) then
			ToReturn[i] = Player
		end
	end
	return ToReturn
end
