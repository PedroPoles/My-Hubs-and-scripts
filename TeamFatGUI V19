			local yOffset = tonumber(list[4]) or 0
			return UDim2.new(xScale, xOffset, yScale, yOffset)
		elseif type == "Content" then
			return value
		elseif type == "float" or type == "int" or type == "double" then
			return tonumber(value)
		elseif type == "string" then
			return value
