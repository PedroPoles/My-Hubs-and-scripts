							0,Frame.VerticalScrollBarPosition == Enum.VerticalScrollBarPosition.Right and absPos.X+absSize.X-scrollThick or absPos.X,
							0,absPos.Y
						)
					end
				end
				
			end
		else
			Bar:Destroy()
			Updater:Disconnect()
			DragEnded:Disconnect()
			if BarDrag then
				BarDrag:Disconnect()
				BarDrag = nil
			end
		end
	end)
	
