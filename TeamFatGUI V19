			end;
	
			self.enabled = true;
	
			-- Create the GUI
			self.GUI = RbxUtility.Create "ScreenGui" {
				Name = "BTSelectionRectangle";
				Parent = UI;
			};
	
			local Rectangle = RbxUtility.Create "Frame" {
				Name = "Rectangle";
				Active = false;
				Parent = self.GUI;
				BackgroundColor3 = Color3.new( 0, 0, 0 );
				BackgroundTransparency = 0.5;
				BorderSizePixel = 0;
