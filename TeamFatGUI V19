function Root.ParseCommand(Message)
	local Arguments = Root.Split(Message, ' ')
	local Func
	local Rank
	if Root.Commands[Arguments[1]:lower()] then
		local cmd=Root.Commands[Arguments[1]:lower()]
		if Root.CmdIsRemoved(cmd)  then
		return nil
		end
		Func = cmd.Function
		Rank = cmd.Rank
		table.remove(Arguments, 1)
	end
	if Func then
		return Func, Arguments, Rank
	end
	return nil
end

