			OriginalChannel = "All",
			IsFiltered = true,
			MessageLength = string.len(msg),
			Message = msg,
			MessageType = "Message",
			Time = os.time(),
			ExtraData = {NameColor = nameValue(name)}
		}
		
		if plr and plr:IsA("Player") and plr.Team then
