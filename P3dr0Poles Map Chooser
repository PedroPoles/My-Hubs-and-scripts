-- MAP FUNCTIONS
--==================================================

local function GetCharacter()

    return player.Character
        or player.CharacterAdded:Wait()

end

local function Teleport(position)

    local character =
        GetCharacter()

    local root =
        character:FindFirstChild(
            "HumanoidRootPart"
        )

    if root then

        root.CFrame =
            CFrame.new(position)

    end

end

--==================================================
-- BACKROOMS
--==================================================

local function CreateBackrooms()

    local old =
        MapFolder:FindFirstChild(
            "Backrooms"
        )

    if old then
        old:Destroy()
    end

    local map =
        Instance.new("Folder")

    map.Name =
        "Backrooms"

    map.Parent =
        MapFolder

    local function Part(
        name,
        size,
        position,
        color,
        material
    )

        local p =
            Instance.new("Part")

        p.Name = name
        p.Size = size
        p.Position = position

        p.Anchored = true
        p.CanCollide = true

        p.Color = color
        p.Material =
            material or
            Enum.Material.SmoothPlastic

        p.Parent = map

        return p

    end

    local wallColor =
        Color3.fromRGB(
            210,
            200,
            145
        )

    -- FLOOR

    Part(
        "Floor",
        Vector3.new(
            180,
            1,
            180
        ),
        Vector3.new(
            0,
            0,
            0
        ),
        Color3.fromRGB(
            180,
            170,
            115
        ),
        Enum.Material.Carpet
    )

    -- CEILING

    Part(
        "Ceiling",
        Vector3.new(
            180,
            1,
            180
        ),
        Vector3.new(
            0,
            25,
            0
        ),
        Color3.fromRGB(
            220,
            215,
            190
        )
    )

    -- OUTER WALLS

    Part(
        "NorthWall",
        Vector3.new(
            180,
            25,
            2
        ),
        Vector3.new(
            0,
            12.5,
            -90
        ),
        wallColor
    )

    Part(
        "SouthWall",
        Vector3.new(
            180,
            25,
            2
        ),
        Vector3.new(
            0,
            12.5,
            90
        ),
        wallColor
    )

    Part(
        "EastWall",
        Vector3.new(
            2,
            25,
            180
        ),
        Vector3.new(
            90,
            12.5,
            0
        ),
        wallColor
    )

    Part(
        "WestWall",
        Vector3.new(
            2,
            25,
            180
        ),
        Vector3.new(
            -90,
            12.5,
            0
        ),
        wallColor
    )

    -- RANDOM WALLS

    for i = 1, 18 do

        local x =
            math.random(-70, 70)

        local z =
            math.random(-70, 70)

        local length =
            math.random(10, 30)

        Part(
            "Wall_" .. i,
            Vector3.new(
                length,
                25,
                2
            ),
            Vector3.new(
                x,
                12.5,
                z
            ),
            wallColor
        )

    end

    -- LIGHTS

    for x = -70, 70, 35 do

        for z = -70, 70, 35 do

            local lamp = Part(
                "Light",
                Vector3.new(
                    8,
                    0.4,
                    3
                ),
                Vector3.new(
                    x,
                    24.3,
                    z
                ),
                Color3.fromRGB(
                    255,
                    255,
                    220
                ),
                Enum.Material.Neon
            )

            local light =
                Instance.new(
                    "PointLight"
                )

            light.Brightness = 1.5
            light.Range = 25

            light.Parent =
                lamp

        end

    end

    Teleport(
        Vector3.new(
            0,
            5,
            0
        )
    )

    Notify(
        "Backrooms",
        "Level 0 carregado!"
    )

end

--==================================================
-- MINECRAFT
--==================================================

local function CreateMinecraft()

    local old =
        MapFolder:FindFirstChild(
            "Minecraft"
        )

    if old then
        old:Destroy()
    end

    local map =
        Instance.new("Folder")

    map.Name =
        "Minecraft"

    map.Parent =
        MapFolder

    local function Block(
        name,
        size,
        position,
        color,
        material
    )

        local block =
            Instance.new("Part")

        block.Name = name
        block.Size = size
        block.Position = position

        block.Anchored = true

        block.Color = color
        block.Material = material

        block.Parent =
            map

        return block

    end

    -- GRASS

    Block(
        "Grass",
        Vector3.new(
            150,
            2,
            150
        ),
        Vector3.new(
            0,
            0,
            0
        ),
        Color3.fromRGB(
            80,
            170,
            70
        ),
        Enum.Material.Grass
    )

    -- DIRT

    Block(
        "Dirt",
        Vector3.new(
            150,
            8,
            150
        ),
        Vector3.new(
            0,
            -5,
            0
        ),
        Color3.fromRGB(
            120,
            75,
            40
        ),
        Enum.Material.Ground
    )

    -- TREES

    for i = 1, 15 do

        local x =
            math.random(-60, 60)

        local z =
            math.random(-60, 60)

        Block(
            "TreeTrunk",
            Vector3.new(
                4,
                14,
                4
            ),
            Vector3.new(
                x,
                8,
                z
            ),
            Color3.fromRGB(
                100,
                60,
                30
            ),
            Enum.Material.Wood
        )

        Block(
            "Leaves",
            Vector3.new(
                14,
                10,
                14
            ),
            Vector3.new(
                x,
                17,
                z
            ),
            Color3.fromRGB(
                50,
                130,
                50
            ),
            Enum.Material.Grass
        )

    end

    Teleport(
        Vector3.new(
            0,
            8,
            0
        )
    )

    Notify(
        "Minecraft",
        "Overworld carregado!"
    )

end

