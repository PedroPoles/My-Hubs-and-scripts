	local TRAIL = CreatePart(3, Effects, "Neon", 0, 0, BrickColor.new("Institutional white").Color , "Trail", VT(0.2,0.2,0.2))
	if TRAIL ~= nil then
	MakeForm(TRAIL,"Cyl")
	local DIST = (FROM - TO).Magnitude
	if BIG == true then
		TRAIL.Size = VT(10,DIST,10)
	else
		TRAIL.Size = VT(0.2,DIST,0.2)
	end
	TRAIL.CFrame = CF(FROM, TO) * CF(0, 0, -DIST/2) * ANGLES(RAD(90),RAD(0),RAD(0))
	coroutine.resume(coroutine.create(function()
		for i = 1, 10 do
			Swait()
			TRAIL.Transparency = TRAIL.Transparency + 0.1
		end
		TRAIL:remove()
	end))
	end
end
